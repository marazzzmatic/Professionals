<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Градиентная заливка -->
    <gradient
        android:angle="135"
        android:startColor="#F22E63"
        android:endColor="#FF6480"
        android:type="linear" />

    <!-- БЕЛАЯ ОБВОДКА -->
    <stroke
        android:width="5dp"
    android:color="#FFFFFF" />

    <!-- Для круга (oval) этот тег не обязателен, но если он есть — он не мешает -->
    <corners android:radius="30dp" />

</shape>